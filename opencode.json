{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "task": "allow"
  },
  "instructions": [
    "AGENTS.md"
  ],
  "references": {
    "specs": {
      "path": "specifications",
      "description": "Architecture, API specs and feature specs for graphrag"
    },
    "docs": {
      "path": ".",
      "description": "Project documentation: README.md, AGENTS.md"
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "rag-server": {
      "type": "local",
      "command": "/home/viktorokh96/Work/graphrag/ragserver",
      "env": {
        "EMBEDDING_PROVIDER": "ollama",
        "EMBEDDING_DIMENSION": "768",
        "RAG_STORE_PATH": "/home/viktorokh96/Work/graphrag/rag_data",
        "QDRANT_URL": "http://localhost:6334",
        "EMBEDDING_MODEL_NAME": "nomic-embed-text:latest",
        "EMBEDDING_BASE_URL": "http://localhost:11434"
      },
      "enabled": true
    }
  },
  "command": {
    "test": {
      "description": "Run pytest tests. Use $ARGUMENTS for path filter (e.g. /test search)",
      "template": "python3 -m pytest tests/ -v $ARGUMENTS"
    },
    "lint": {
      "description": "Run ruff linter on src/ and tests/",
      "template": "ruff check src/ tests/ $ARGUMENTS"
    },
    "bench": {
      "description": "Run NDCG benchmark to calibrate default_alpha",
      "template": "python3 -m scripts.benchmark_alpha $ARGUMENTS"
    },
    "search": {
      "description": "Hybrid search in knowledge base via CLI. Usage: /search <query>",
      "template": "python3 -m src.cli hybrid-search --query \"$ARGUMENTS\""
    },
    "start": {
      "description": "Start the RAG MCP server (stdio mode)",
      "template": "EMBEDDING_MODEL=bge-m3 /home/viktorokh96/Work/graphrag/.venv/bin/python3 -m src.mcp_server"
    },
    "start-http": {
      "description": "Start the RAG MCP server (HTTP SSE mode). Usage: /start-http [--port 8765] [--qdrant] [--preload]",
      "template": "bash scripts/start_http_mcp.sh $ARGUMENTS"
    },
    "qdrant": {
      "description": "Start/stop Qdrant. Usage: /qdrant [docker|local|--stop]",
      "template": "bash scripts/start_qdrant_docker.sh $ARGUMENTS"
    },
    "add": {
      "description": "Add a text document to the knowledge base. Usage: /add <text>",
      "template": "python3 -m src.cli add-document --text \"$ARGUMENTS\""
    }
  }
}