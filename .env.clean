# Clean instance ports (different from existing 6333/8765)
QDRANT_PORT=6335
HTTP_PORT=8766

# Data on real disk — clean, separate directory
QDRANT_DATA_DIR=./rag_data_clean/qdrant_storage

# Embedding: same provider as .env
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL_NAME=vllm/bge-m3
EMBEDDING_BASE_URL=https://bifrost.k8s.rnd.perfectlab.com/v1
EMBEDDING_API_KEY=EMBEDDING_API_KEY=your-key-here

# Chunking
CHUNK_SIZE=512

# Reranker — off by default for clean instance
RERANK_ENABLED=false
RERANK_MODEL=mixedbread-ai/mxbai-rerank-xsmall-v1
RERANK_DEVICE=cpu

# Query expansion — off
QUERY_EXPANSION_ENABLED=false

# Preload — off
PRELOAD_MODELS=false
