# === Провайдер эмбеддингов ===
# Выбор: ollama (по умолчанию) или openrouter
EMBEDDING_PROVIDER=ollama

# === Ollama (локальные эмбеддинги) ===
# Установите Ollama: https://ollama.com/
# Скачайте модель: ollama pull qwen3-embedding
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-embedding:8b
# Размерность эмбеддингов (qwen3-embedding = 4096, nomic-embed-text = 768)
# OLLAMA_DIMENSION=4096

# === OpenRouter (внешние эмбеддинги) ===
# Раскомментируйте и укажите ключ, чтобы использовать OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# OPENROUTER_MODEL=openai/text-embedding-3-small

# === Хранилище ===
# STORE_PATH=./rag_data