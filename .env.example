# === Провайдер эмбеддингов ===
# Выбор: bge-m3 (по умолчанию), ollama, openrouter
EMBEDDING_PROVIDER=bge-m3

# === BGE-M3 (sentence-transformers, мультиязычные, 1024d) ===
# Используется по умолчанию, lazy load при первом вызове
# BGE_MODEL=BAAI/bge-m3
# BGE_DEVICE=cpu
# Не обращаться к HuggingFace Hub (только локальный кеш):
# HF_HUB_OFFLINE=true

# === Локальные модели ===
# Скачать модели скриптом: bash scripts/setup_models.sh
# Указать директорию — код грузит отсюда, а не из HF Hub:
# MODELS_DIR=./models
# Загружать модели в память при старте (быстрый первый запрос):
# PRELOAD_MODELS=true

# === Ollama (локальные эмбеддинги) ===
# Установите Ollama: https://ollama.com/
# Скачайте модель: ollama pull qwen3-embedding
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-embedding:8b
# Размерность эмбеддингов (qwen3-embedding = 4096, nomic-embed-text = 768)
# OLLAMA_DIMENSION=4096

# === OpenRouter (внешние эмбеддинги) ===
# Раскомментируйте и укажите ключ, чтобы использовать OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# OPENROUTER_MODEL=openai/text-embedding-3-small
# OPENROUTER_DIMENSION=1536

# === Хранилище ===
# STORE_PATH=./rag_data

# === Qdrant ===
# По умолчанию — embedded (локальный файл, один процесс).
# Рекомендуется: Docker Qdrant для concurrent-доступа (несколько MCP-клиентов):
#   docker compose up -d qdrant
#   QDRANT_URL=http://localhost:6333
# Если QDRANT_URL не задан — используется embedded (файл ./rag_data/qdrant).
# QDRANT_URL=http://localhost:6333

# === Гибридный поиск (RRF) ===
# Баланс семантика(1.0)/BM25(0.0) для некириллических запросов (по умолчанию 0.5)
# RAG_DEFAULT_ALPHA=0.5
# Баланс для кириллических запросов (по умолчанию 0.85 — BM25 без стемминга шумит)
# RAG_CYRILLIC_ALPHA=0.85
# Candidate expansion: из каждого канала забирается max(k*3, 20) кандидатов перед fusion
# RAG_HYBRID_EXPAND=3
# RAG_HYBRID_MIN_CANDIDATES=20

# === Reranker (CrossEncoder) ===
# Включить CrossEncoder reranking по умолчанию (false)
# RERANK_ENABLED=false
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_DEVICE=cpu
# RERANK_TOP_K_MULTIPLIER=2

# === Query Expansion (Multi-query LLM) ===
# Включить multi-query expansion по умолчанию (false)
# QUERY_EXPANSION_ENABLED=false
# QUERY_EXPANSION_MODEL=qwen3:1.8b
# QUERY_EXPANSION_COUNT=3
# QUERY_EXPANSION_OLLAMA_URL=http://localhost:11434

# === Graph Extraction (авто-извлечение графа) ===
# GEMBEDDING_PROVIDER=ollama
# GEMBEDDING_BASE_URL=http://localhost:11434
# GEMBEDDING_MODEL=qwen3:4b
