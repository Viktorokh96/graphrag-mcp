# === Провайдер эмбеддингов ===
# Тип: openai-compatible | anthropic | ollama | sentence_transformer
EMBEDDING_PROVIDER=openai-compatible
# Имя модели (BAAI/bge-m3, text-embedding-3-small, qwen3-embedding:8b, ...)
EMBEDDING_MODEL=BAAI/bge-m3
# Базовый URL API (для openai-compatible, anthropic, ollama)
# EMBEDDING_BASE_URL=http://localhost:8080/v1
# API ключ (если требуется)
# EMBEDDING_API_KEY=
# Размерность эмбеддингов (BGE-M3 = 1024, qwen3-embedding = 4096)
# EMBEDDING_DIM=1024
# Устройство (только для sentence_transformer)
# EMBEDDING_DEVICE=cpu
# Preload модели при старте (только для sentence_transformer)
# PRELOAD_MODELS=true
# Директория с локальными моделями (только для sentence_transformer)
# MODELS_DIR=./models

# === Хранилище ===
# STORE_PATH=./rag_data

# === Qdrant ===
# По умолчанию — embedded (локальный файл, один процесс).
# Рекомендуется: Docker Qdrant для concurrent-доступа:
#   docker compose up -d qdrant
#   QDRANT_URL=http://localhost:6333
# QDRANT_URL=http://localhost:6333
# QDRANT_DATA_DIR=./rag_data/qdrant_storage

# === Гибридный поиск (RRF) ===
# RAG_DEFAULT_ALPHA=0.5
# RAG_CYRILLIC_ALPHA=0.85
# RAG_HYBRID_EXPAND=3
# RAG_HYBRID_MIN_CANDIDATES=20

# === Чанкование ===
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64

# === Reranker ===
# Тип: openai-compatible | sentence_transformer
# RERANK_ENABLED=false
# RERANK_PROVIDER=sentence_transformer
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_DEVICE=cpu
# RERANK_TOP_K_MULTIPLIER=2

# === Query Expansion ===
# Тип: openai-compatible | anthropic | ollama
# QUERY_EXPANSION_ENABLED=false
# EXPANSION_PROVIDER=ollama
# EXPANSION_MODEL=qwen3:1.8b
# EXPANSION_BASE_URL=http://localhost:11434
# EXPANSION_API_KEY=
# EXPANSION_COUNT=3

# === Graph Extraction (авто-извлечение графа) ===
# GEMBEDDING_PROVIDER=ollama
# GEMBEDDING_BASE_URL=http://localhost:11434
# GEMBEDDING_MODEL=qwen3:4b
