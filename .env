# === Провайдер эмбеддингов ===
# Тип: openai-compatible | anthropic | ollama | sentence_transformer
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=vllm/bge-m3
EMBEDDING_BASE_URL=https://bifrost.k8s.rnd.perfectlab.com/
EMBEDDING_API_KEY=sk-bf-44180494-8f5d-4bc0-8427-7a46d4c3d162
# EMBEDDING_DIM=1024

# === Хранилище ===
STORE_PATH=./rag_data

# === Qdrant ===
QDRANT_URL=http://localhost:6333
# QDRANT_DATA_DIR=./rag_data/qdrant_storage

# === Гибридный поиск (RRF) ===
# RAG_DEFAULT_ALPHA=0.5
# RAG_CYRILLIC_ALPHA=0.85
# RAG_HYBRID_EXPAND=3
# RAG_HYBRID_MIN_CANDIDATES=20

# === Reranker ===
RERANK_ENABLED=false
# RERANK_PROVIDER=sentence_transformer
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_TOP_K_MULTIPLIER=2

# === Query Expansion ===
QUERY_EXPANSION_ENABLED=false
# EXPANSION_PROVIDER=ollama
# EXPANSION_MODEL=qwen3:1.8b
# EXPANSION_BASE_URL=http://localhost:11434
# EXPANSION_API_KEY=
# EXPANSION_COUNT=3

# === Graph Extraction (авто-извлечение графа) ===
